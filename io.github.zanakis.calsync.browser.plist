<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.zanakis.calsync.browser</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/calsync/.venv/bin/python</string>
    <string>/Users/YOUR_USERNAME/calsync/owa.py</string>
    <string>browser</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/calsync/calsync-browser.log</string>
</dict>
</plist>
